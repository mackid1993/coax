# coax: settings for docker-compose.yml (no VPN).
# Copy this file to .env next to docker-compose.yml and edit it:
#   cp .env.example .env
# Everything else (providers, channels, lineups, Base URL, transcode) is set in the coax web UI
# and saved in ./data/config.json.

# Port coax is published on, on this machine. Base URL in coax Settings must use this port.
COAX_PORT=7780

# Your timezone, for log timestamps. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York
