# coax + Gluetun: settings for docker-compose.vpn.yml.
# Copy this file to .env next to docker-compose.vpn.yml, fill it in, and keep it private:
#   cp .env.vpn.example .env && chmod 600 .env
# Gluetun builds the tunnel from these values; there are no VPN config files to mount.
# Gluetun's guide for every provider: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers

# ---------------------------------------------------------------- common
# Port coax is published on (through Gluetun). Base URL in coax Settings must use this port.
COAX_PORT=7780

# Your LAN, so coax can reach Channels DVR outside the tunnel. Comma separated, e.g. 192.168.1.0/24.
# Must not overlap the VPN's own address range.
LAN_SUBNETS=192.168.1.0/24

# Your timezone, for log timestamps.
TZ=America/New_York

# ---------------------------------------------------------------- A. WireGuard (default)
# Gluetun's custom WireGuard provider; works with any WireGuard VPN.
# Copy the values from your provider's WireGuard config:
#   https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers/custom.md
WG_ENDPOINT_IP=          # [Peer] Endpoint, IP part (must be an IP address, not a hostname)
WG_ENDPOINT_PORT=        # [Peer] Endpoint, port part, e.g. 51820
WG_PUBLIC_KEY=           # [Peer] PublicKey
WG_PRIVATE_KEY=          # [Interface] PrivateKey
WG_PRESHARED_KEY=        # [Peer] PresharedKey (leave empty if your provider has none)
WG_ADDRESSES=            # [Interface] Address, e.g. 10.64.12.34/32

# ---------------------------------------------------------------- B. OpenVPN (optional)
# To use this instead: in docker-compose.vpn.yml comment out block A and uncomment block B,
# then fill these in. VPN_PROVIDER is the name used on the provider's Gluetun wiki page.
VPN_PROVIDER=            # e.g. windscribe, mullvad, protonvpn, private internet access
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=        # e.g. Netherlands
